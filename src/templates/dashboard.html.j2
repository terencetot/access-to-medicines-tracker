<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>Access to Medicines Tracking Platform</title>
<meta name="description" content="Access to Medicines Tracking Platform for neurological disorders and dementia, WHO African Region. IGAP 2022-2031 and the global action plan on dementia.">
<link rel="icon" href="data:,">
<style>
{{ css | safe }}
</style>
</head>
<body>
<a class="skip-link" href="#main-content">Skip to main content</a>
{{ icons | safe }}

<div id="reading-progress"></div>
<button id="back-to-top" type="button" aria-label="Back to top">
  <svg><use href="#icon-arrow-up"/></svg>
</button>

<div id="tooltip" role="tooltip"></div>

{% include "partials/top_bar.html.j2" %}

<div class="app-shell">
  <button id="nav-toggle" aria-label="Open navigation" aria-expanded="false" aria-controls="side-nav">
    <svg><use href="#icon-menu"/></svg>
  </button>

  {% include "partials/side_nav.html.j2" %}

  <main class="main" id="main-content">
    {% include "partials/hero.html.j2" %}
    <div class="main-inner">
      <div class="tab-pane is-active" data-tab="summary">
        {% include "partials/regional_summary.html.j2" %}
      </div>
      <div class="tab-pane" data-tab="progress">
        {% include "partials/country_progress.html.j2" %}
      </div>
      <div class="tab-pane" data-tab="heatmap">
        {% include "partials/heatmap.html.j2" %}
      </div>
      <div class="tab-pane" data-tab="results">
        {% include "partials/results.html.j2" %}
      </div>
      <div class="tab-pane" data-tab="tracer">
        {% include "partials/tracer_basket.html.j2" %}
      </div>
      <div class="tab-pane" data-tab="risks">
        {% include "partials/risk_register.html.j2" %}
      </div>
      <div class="tab-pane" data-tab="methods">
        {% include "partials/glossary.html.j2" %}
        {% include "partials/methods_annex.html.j2" %}
      </div>
    </div>
  </main>
</div>

{% include "partials/bottom_bar.html.j2" %}

{% include "partials/country_panel.html.j2" %}

<script>
{% include "partials/script.js.j2" %}
</script>
</body>
</html>
