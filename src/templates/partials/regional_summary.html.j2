<section class="section" aria-labelledby="summary-h2">
  <div class="section-head">
    <div class="section-eyebrow"><span class="n">1</span>Regional summary</div>
    <h2 id="summary-h2">Where the six countries stand</h2>
    <p class="section-sub">Every figure below carries its denominator. Where a card names a global target, it is the target that indicator serves.</p>
  </div>
  <div class="grid grid-metrics">
    {% for m in regional_summary %}
    <div class="card metric-card">
      <div class="m-icon" style="background:var(--primary)"><svg><use href="#{{ m.icon }}"/></svg></div>
      <div class="metric-value">{{ m.value }} <span class="denom">{{ m.denom }}</span></div>
      <div class="metric-label">{{ m.label }}</div>
      {% if m.target %}<div class="metric-target">Serves {{ m.target }}</div>{% endif %}
    </div>
    {% endfor %}
  </div>

  <div class="section-divider"></div>

  <h3 class="subsection-title">Milestone status by phase, region-wide</h3>
  <p class="section-sub" style="margin-bottom:16px">All 186 country&times;milestone cells from the heatmap, aggregated by phase. The count on the right is completed over total.</p>
  <div class="card" style="overflow-x:auto">
    {{ phase_distribution_svg | safe }}
    <div class="legend" style="margin-top:16px">
      <span class="item"><span class="status-pill st-C">C</span> Completed</span>
      <span class="item"><span class="status-pill st-IP">IP</span> In progress</span>
      <span class="item"><span class="status-pill st-D">D</span> Delayed</span>
      <span class="item"><span class="status-pill st-NS">NS</span> Not started</span>
      <span class="item"><span class="status-pill st-NA">NA</span> Not applicable</span>
    </div>
  </div>
</section>
