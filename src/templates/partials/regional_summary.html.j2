<section class="section" aria-labelledby="summary-h2">
  <div class="section-head">
    <div class="section-eyebrow"><span class="n">1</span>Regional summary</div>
    <h2 id="summary-h2">Where the six countries stand</h2>
    <p class="section-sub">Every figure below carries its denominator. Where a card names a global target, it is the target that indicator serves.</p>
  </div>
  <div class="grid grid-metrics">
    {% for m in regional_summary %}
    <div class="card metric-card">
      <div class="m-icon" style="background:var(--primary)"><svg><use href="#{{ m.icon }}"/></svg></div>
      <div class="metric-value">{{ m.value }} <span class="denom">{{ m.denom }}</span></div>
      <div class="metric-label">{{ m.label }}</div>
      {% if m.target %}<div class="metric-target">Serves {{ m.target }}</div>{% endif %}
    </div>
    {% endfor %}
  </div>
</section>
