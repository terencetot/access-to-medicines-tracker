<section class="section" id="section-tracer" aria-labelledby="tracer-h2">
  <div class="section-head">
    <div class="section-eyebrow"><span class="n">5</span>Tracer basket</div>
    <h2 id="tracer-h2">23 medicines and care product categories</h2>
    <p class="section-sub">Anchored on the WHO Model List of Essential Medicines, 24th list (2025), the WHO/HAI global and sub-Saharan Africa core lists, and Global Dementia Observatory indicator 10.</p>
  </div>

  <div class="notice-band">
    <strong>Standing note.</strong> No antidementia medicine (donepezil, galantamine, rivastigmine, memantine) appears on the WHO Model List of Essential Medicines, 24th list (2025). Access to these medicines is therefore not measured as essential-medicines availability; it is measured through regulatory approval, generic availability and on-label reimbursement (results indicators D6&ndash;D9), following Global Dementia Observatory indicator 10.
  </div>

  {% for category, items in tracer_by_category.items() %}
  <div class="tracer-category">
    <h3 style="font-size:14px;margin-bottom:8px">{{ category }}</h3>
    <div class="table-wrap" style="margin-bottom:18px">
      <table class="data-table">
        <thead>
          <tr>
            <th>ID</th><th>Medicine / product</th><th>Strength</th><th>Dosage form</th>
            <th>Model List status</th><th>Position in survey list</th><th>IGAP</th><th>Dementia</th>
          </tr>
        </thead>
        <tbody>
          {% for t in items %}
          <tr>
            <td class="num">{{ t.ID }}</td>
            <td>{{ t['International non-proprietary name'] }}</td>
            <td>{{ t.Strength or '—' }}</td>
            <td>{{ t['Dosage form'] or '—' }}</td>
            <td style="font-size:11.5px">{{ t['WHO Model List status (24th list, 2025)'] }}</td>
            <td style="font-size:11.5px">{{ t['Position in the survey medicine list'] }}</td>
            <td>{% if t['IGAP relevance'] == 'Yes' %}<span class="chip yes">Yes</span>{% else %}<span class="chip no">No</span>{% endif %}</td>
            <td>{% if t['Dementia relevance'] == 'Yes' %}<span class="chip yes">Yes</span>{% else %}<span class="chip no">No</span>{% endif %}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
  {% endfor %}

  {% if tracer_notes %}
  <div class="card" style="font-size:12px;color:var(--muted);line-height:1.8">
    <strong style="color:var(--ink);display:block;margin-bottom:6px">Notes on file (sheet 07, verbatim)</strong>
    <ul style="margin:0;padding-left:18px">
      {% for note in tracer_notes %}
      <li>{{ note }}</li>
      {% endfor %}
    </ul>
  </div>
  {% endif %}
</section>
